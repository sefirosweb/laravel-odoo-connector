{
    "name": "sefirosweb/laravel-odoo-connector",
    "description": "Driver to connect Odoo using ORM of laravel",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sefirosweb\\LaravelOdooConnector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sefirosweb\\LaravelOdooConnector\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Sefirosweb",
            "email": "sefirosweb@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sefirosweb\\LaravelOdooConnector\\LaravelOdooConnectorServiceProvider"
            ]
        }
    }
}
